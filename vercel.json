{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/pk-produce.js": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "redirects": [
    {
      "source": "/pearson-killer.html",
      "destination": "/modo-trampa.html",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/migration-runner",
      "destination": "/pk-migration-runner.html"
    }
  ]
}
